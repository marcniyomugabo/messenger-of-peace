# Copy this file to .env (same folder) and fill in your own values.
# .env is ignored by git - never commit real secrets.
# Locally the values below work as they are (with XAMPP). For the live site see
# "Deploy" in the README: NODE_ENV=production turns on safety checks.

# ---- Server ----
# Port the server listens on. Locally the website (Vite) forwards /api to 3001.
PORT=3001
# development on your computer, production on the live site.
NODE_ENV=development
# Time zone for "today" (default dates on payments, income, expenses, members).
TZ=Africa/Kigali

# ---- Login tokens ----
# Long random strings, different from each other. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server will not start with the example values or with secrets under 32 characters.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# ---- Database (MySQL / MariaDB; XAMPP defaults shown) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Required in production.
DB_PASSWORD=
DB_NAME=messengers_of_peace
# Time zone the database works in (NOW(), "this month"). Rwanda is +02:00 all year.
DB_TIMEZONE=+02:00

# ---- First admin (created by "npm run seed" if it does not exist yet) ----
# Locally the defaults are admin@mop.rw / Admin@123. In production ADMIN_PASSWORD is required:
# at least 12 characters, with letters and numbers. Seeding never changes an existing admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The website's address, used in links sent by email ("forgot password").
# Locally the site's Vite address; online the real address, e.g. https://mopscouts.rw (required in production).
SITE_URL=http://localhost:3000

# ---- Live site (production) ----
# Behind a host's proxy (Render, Railway, Nginx, Cloudflare, ...) set to 1, so the login limit
# counts each visitor separately. Leave empty when the server is reached directly.
TRUST_PROXY=
# Other websites allowed to call the API from a browser, comma-separated, e.g.
#   https://mopscouts.rw,https://www.mopscouts.rw
# Not needed when this server serves the website itself (the recommended setup).
CORS_ORIGIN=
# Folder for files uploaded from the dashboard. Use a permanent disk online (many hosts wipe
# the app folder on each deploy). Default: server/src/uploads
UPLOAD_DIR=
# The built website (client/dist after "npm run build"). Default: ../client/dist
CLIENT_DIST=

# ---- Email (optional). Leave SMTP_USER empty to skip sending emails. ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SITE_EMAIL=info@mopscouts.rw

# Maximum upload size in bytes (default 25 MB)
MAX_FILE_SIZE=26214400
